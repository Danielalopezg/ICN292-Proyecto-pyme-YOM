digraph ER {
graph [rankdir=LR, nodesep=0.5, ranksep=1.1, fontname="Helvetica", bgcolor="white"];
node [shape=plaintext, fontname="Helvetica"];
edge [arrowhead=none, color="#455A64", fontname="Helvetica", fontsize=10];
COLABORADOR [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>COLABORADOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_colaborador</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">telefono</FONT></TD></TR></TABLE>>];
ONBOARDING [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>ONBOARDING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_onboarding</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">codigo (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email_personal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">correo_corporativo (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rut (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">cargo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo_vinculo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_lider</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_buddy</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">link_carta_oferta</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_ingreso</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_registro</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">flujo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">consentimiento_datos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_consentimiento</FONT></TD></TR></TABLE>>];
CONTACTO_EMERGENCIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>CONTACTO_EMERGENCIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK/FK id_onboarding</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nombre</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">telefono</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">relacion</FONT></TD></TR></TABLE>>];
CONTRATO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>CONTRATO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_contrato</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_onboarding (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_solicitud</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_firma</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR></TABLE>>];
DOCUMENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>DOCUMENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_documento</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_onboarding</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">tipo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">drive_file_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_solicitud</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_recepcion</FONT></TD></TR></TABLE>>];
NOTIFICACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>NOTIFICACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_notificacion</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_onboarding</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK codigo_accion</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_envio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">estado</FONT></TD></TR></TABLE>>];
ACCION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>ACCION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK codigo</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nodo_n8n (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">canal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">destinatario_rol</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">diferida</FONT></TD></TR></TABLE>>];
REUNION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1B3A6B"><TR><TD BGCOLOR="#1B3A6B"><FONT COLOR="white"><B>REUNION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><B><U>PK id_reunion</U></B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">FK id_onboarding (UQ)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">event_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">inicio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fin</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fecha_agendada</FONT></TD></TR></TABLE>>];
COLABORADOR -> ONBOARDING [taillabel="1", headlabel="N", label=<<I>lidera</I>>, labeldistance=1.6];
COLABORADOR -> ONBOARDING [taillabel="1", headlabel="N", label=<<I>acompaña (buddy)</I>>, labeldistance=1.6];
ONBOARDING -> CONTACTO_EMERGENCIA [taillabel="1", headlabel="1", label=<<I>declara</I>>, labeldistance=1.6];
ONBOARDING -> CONTRATO [taillabel="1", headlabel="1", label=<<I>genera</I>>, labeldistance=1.6];
ONBOARDING -> DOCUMENTO [taillabel="1", headlabel="N", label=<<I>requiere</I>>, labeldistance=1.6];
ONBOARDING -> NOTIFICACION [taillabel="1", headlabel="N", label=<<I>dispara</I>>, labeldistance=1.6];
ACCION -> NOTIFICACION [taillabel="1", headlabel="N", label=<<I>tipifica</I>>, labeldistance=1.6];
ONBOARDING -> REUNION [taillabel="1", headlabel="1", label=<<I>agenda</I>>, labeldistance=1.6];
}