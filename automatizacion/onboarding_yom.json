      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// 1) Lee fechaIngreso desde el item actual o desde Edit Fields\nconst raw =\n  $json.fechaIngreso ??\n  $json[\"fechaIngreso\"] ??\n  $json[\"Fecha ingreso\"] ??\n  $('Edit Fields').item?.json?.fechaIngreso;\n\nif (!raw) {\n  throw new Error(\"fechaIngreso viene vacío/undefined. Revisa el nodo Edit Fields.\");\n}\n\n// 2) Normaliza a string\nlet s = raw;\nif (typeof s === \"object\" && s !== null) s = s.value ?? s.date ?? s.start ?? s.toString();\ns = String(s).trim();\n\n// 3) Extrae fecha en formato YYYY-MM-DD o DD/MM/YYYY\nlet isoDate = null;\n\n// Caso 1: ya viene YYYY-MM-DD\nconst m1 = s.match(/\\b(\\d{4}-\\d{2}-\\d{2})\\b/);\nif (m1) isoDate = m1[1];\n\n// Caso 2: viene DD/MM/YYYY\nif (!isoDate) {\n  const m2 = s.match(/\\b(\\d{2})\\/(\\d{2})\\/(\\d{4})\\b/);\n  if (m2) {\n    const [_, dd, mm, yyyy] = m2;\n    isoDate = `${yyyy}-${mm}-${dd}`;\n  }\n}\n\nif (!isoDate) {\n  throw new Error(`No pude reconocer una fecha en fechaIngreso: \"${s}\"`);\n}\n\n// 4) Construye start/end con zona horaria Chile (-03:00)\nconst start = new Date(`${isoDate}T10:00:00-03:00`);\nconst end = new Date(start.getTime() + 60 * 60 * 1000);\n\nif (isNaN(start.getTime()) || isNaN(end.getTime())) {\n  throw new Error(`Fecha inválida luego de parsear. isoDate=\"${isoDate}\" raw=\"${s}\"`);\n}\n\nreturn [\n  {\n    ...$json,\n    startDateTimeISO: start.toISOString(),\n    endDateTimeISO: end.toISOString(),\n    debug_rawFechaIngreso: s,\n    debug_isoDate: isoDate,\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
